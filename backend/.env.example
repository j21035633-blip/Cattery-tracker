# --- Core ---
ENVIRONMENT=local
SECRET_KEY=change-me-openssl-rand-hex-32

# --- MongoDB ---
# Railway's plugin injects MONGO_URL; MONGODB_URL wins when both are set.
MONGODB_URL=mongodb://127.0.0.1:27017
MONGODB_DB_NAME=cattery
# The integration tests drop this database between tests, so it must never
# point at the development one.
TEST_MONGODB_DB_NAME=cattery_test

# --- Auth ---
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- CORS (web + Expo dev client) ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# --- Notifications ---
# EXPO_ACCESS_TOKEN=
OVERDUE_SWEEP_INTERVAL_MINUTES=15
NOTIFICATION_RETENTION_DAYS=90
