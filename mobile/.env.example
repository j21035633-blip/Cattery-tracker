# Base URL of the Cattery Tracker API. EXPO_PUBLIC_ vars are inlined into the
# bundle at build time, so a change needs a rebuild, not just a restart.
#
# Leave this as localhost for the Android emulator, the iOS simulator and web:
# the client rewrites localhost to 10.0.2.2 on the Android emulator, which is
# that VM's alias for the host machine (see resolveApiUrl in src/lib/api.ts).
#
# For a PHYSICAL device, replace it with your machine's LAN address, e.g.
# http://192.168.1.23:8000 — a phone's "localhost" is the phone itself. The
# backend must be started with --host 0.0.0.0 to accept that connection.
EXPO_PUBLIC_API_URL=http://localhost:8000

# From `eas init`. Required for getExpoPushTokenAsync() in a dev/EAS build.
EAS_PROJECT_ID=

# Android only: path to the FCM V1 google-services.json. On EAS, provide it as
# a file secret and set this to its path.
# GOOGLE_SERVICES_JSON=./google-services.json
